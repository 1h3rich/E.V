# Copia este fichero a un nuevo archivo llamado ".env" (con el punto delante,
# sin el prefijo "env.") en la misma carpeta, y rellena tus valores ahi.

# API key de Anthropic (obligatoria si AI_PROVIDER=claude)
ANTHROPIC_KEY=

# API key de OpenAI (solo si AI_PROVIDER=openai)
OPENAI_KEY=

# Proveedor de IA: "claude" u "openai"
AI_PROVIDER=claude

# Modelo local de Whisper para transcribir tu voz: tiny, base, small, medium...
WHISPER_MODEL=base

# Idioma de transcripcion
LANGUAGE=es

# Similitud coseno minima (0-1) para reconocer una voz enrolada
VOICE_MATCH_THRESHOLD=0.65

# Atajo de teclado para activar/desactivar la escucha continua.
# HOTKEY_MODIFIER admite: super, ctrl, alt, shift, o combinaciones con "+"
# (ej. "ctrl+alt", "ctrl+shift"). HOTKEY_KEY es una sola letra.
HOTKEY_MODIFIER=super
HOTKEY_KEY=y
